+                    marker="o" if all(row["both_completed"] for row in selected) else "x",
+                    label=LABELS[condition] if kind_index == 0 and seed_index == 0 else None,
+                )
+                axis.annotate(
+                    str(seed),
+                    (kind_index + offset, mean_difference),
