+            selected = [
+                row
+                for row in rows
+                if row["condition"] == condition and row["training_seed"] == seed
+            ]
+            offsets = np.arange(len(case_ids)) + (index - (len(seeds) - 1) / 2) * 0.13
+            color = f"C{index % 10}"
+            axis.scatter(
+                [row["rmse_difference_mps"] for row in selected],
+                offsets,
+                color=color,
+                s=28,
+                label=f"seed {seed}",
