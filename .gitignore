.venv/
.local-deps/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/
results/residual_ppo/*.pth

# Local working notes; published learning material lives in docs/.
/task_plan.md
/findings.md
/progress.md

# Raw experiment payloads are distributed with checksums as release artifacts.
# Existing tracked historical evidence is retained in Git.
/results/**/*.csv
/results/**/*.csv.gz
/results/**/*.jsonl
/results/**/*.npz
/results/**/*.mjb
/results/**/*.mjb.gz
/results/**/*.tar.gz
# Interrupted studies and duplicate source trees remain in the result release.
/results/d1_budget_study_interrupted_*/
/results/.d1_budget_study.recovery*.lock
/results/d1_delay_channel_study/**/source/
/results/d1_budget_demo/**/*.xwd
# Completed raw logs and exploratory captures are kept in the v0.8 result bundle.
/results/d1_budget_study/logs/
/results/d1_budget_study/source_extras/
/results/d1_budget_demo/gui/
/results/d1_budget_demo/gui_retry/capture.log
/results/d1_budget_demo/gui_retry/viewer.log
/results/d1_budget_demo/probe_gpu/
/results/d1_budget_demo/probe_lp1/
/results/d1_course_heading_revision/heading_gui_check_01/process.log
# Byte-identical copy is published under d1_course_manual_acceptance_failed/rollout.
/results/my_course_acceptance_20260912_01/
# Local MuJoCo diagnostic; retained separately from completed experiment records.
/MUJOCO_LOG.TXT
# The reference-diagnosis telemetry JSON stays in Git: a frozen hash regression needs it.

# These small inputs keep links in checksum-frozen historical reports usable.
!/results/d1_action_ablation_analysis/checkpoint_audit.csv
!/results/d1_action_ablation_analysis/holdout_controller_means.csv
!/results/d1_action_ablation_analysis/holdout_episode_metrics.csv
!/results/d1_action_ablation_analysis/training_action_statistics.csv
!/results/d1_action_ablation_analysis/development_fixed_six.csv
!/results/d1_action_ablation_analysis/development_final_24.csv
!/results/d1_action_ablation_analysis/analysis_source.tar.gz
!/results/d1_residual_feedback/historical_failure_types.csv
!/results/d1_residual_feedback/metrics_corrected.csv
!/results/d1_residual_feedback/metrics.csv

# This small single-axis experiment keeps its complete compressed records in Git.
!/results/encoder_identification_position_only/**/*.csv
!/results/encoder_identification_position_only/**/*.csv.gz
!/results/encoder_identification_position_only/source.tar.gz
